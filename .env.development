# Vite `npm run dev` — browser calls same-origin `/api`; proxy in vite.config.js forwards to API.
# Overrides generic `.env` so absolute production URLs do not trigger CORS on localhost.
#
# Remote API (default target in vite.config.js). Override for local Nest:
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000
VITE_API_URL=/api