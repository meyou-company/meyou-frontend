# API (Nest має глобальний префікс /api)
#
# Production (recommended custom API host):
# VITE_API_URL=https://api.lunmeyo.com/api
# VITE_SOCKET_URL=https://api.lunmeyo.com
#
# Якщо змінна порожня, у проді використовується /api і Vercel проксує його (vercel.json) на api.lunmeyo.com.
#
# Локально без змінної: dev-режим використовує /api → proxy у vite.config.js (за замовчуванням http://localhost:3000)
# VITE_DEV_API_PROXY_TARGET=https://api.lunmeyo.com
#
# Публічний origin для шеру постів (після переходу на кастомний домен):
# VITE_PUBLIC_APP_URL=https://lunmeyo.com

VITE_API_URL=

# SEC-009 P1.3.2 protected chat attachments (default off — backend flag + Cloudinary MAC required)
# VITE_SEC009_CHAT_PRIVATE_DELIVERY_ENABLED=false
