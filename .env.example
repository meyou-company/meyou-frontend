# =============================================================================
# Local development (`npm run dev`)
# =============================================================================
# Default: committed `.env.development` sets VITE_API_URL=/api and Vite proxies
# /api + /socket.io → https://api.lunmeyo.com (override below for local Nest).
#
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000
#
# Remove stale values from `.env.local` (e.g. old meyou-api.onrender.com or absolute
# VITE_API_URL) — `.env.local` overrides `.env.development` and breaks the proxy.
#
# =============================================================================
# Production build (Vercel)
# =============================================================================
# VITE_API_URL=https://api.lunmeyo.com/api
# VITE_SOCKET_URL=https://api.lunmeyo.com
#
# Or leave VITE_API_URL empty and use vercel.json rewrite /api → api.lunmeyo.com.

VITE_API_URL=

# Optional: force Socket.IO origin in prod when not using same host as the SPA
# VITE_SOCKET_URL=https://api.lunmeyo.com

# VITE_PUBLIC_APP_URL=https://lunmeyo.com

# Vercel Edge Middleware (optional): API host for social-bot HTML preview
# LINK_PREVIEW_API_ORIGIN=https://api.lunmeyo.com

# SEC-009 P1.3.2 protected chat attachments (default off)
# VITE_SEC009_CHAT_PRIVATE_DELIVERY_ENABLED=false

# Production monitoring P0 (Sentry — off by default)
# VITE_SENTRY_ENABLED=false
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_SAMPLE_RATE=1
# VITE_APP_RELEASE=  # git SHA at build time (CI)