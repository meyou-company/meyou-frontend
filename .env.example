# API (Nest має глобальний префікс /api)
#
# Production (Vercel): обовʼязково задати точний базовий URL Render:
# VITE_API_URL=https://meyou-api.onrender.com/api
#
# Якщо змінна порожня, у проді використовується /api і Vercel проксує його (vercel.json) на Render.
#
# Local Epidemic Sound / Stories / Reels test MUST use the Vite proxy to local meyou-api.
# If this is set to https://meyou-api.onrender.com/api, music search hits production
# (no Epidemic Sound module) and shows "not found".
# Local: empty or /api → vite.config.js proxy (default http://localhost:3000)
# VITE_DEV_API_PROXY_TARGET=http://localhost:3000

VITE_API_URL=
